NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional server-only URL for VPS-internal Supabase calls. In production on Contabo:
# SUPABASE_INTERNAL_URL=http://supabase-kong:8000
SUPABASE_INTERNAL_URL=

# App
# Production should be the single dashboard origin, not a comma-separated Coolify URL list.
APP_URL=http://localhost:3000
# Optional override for media URLs that external social platforms must fetch.
PUBLIC_APP_URL=
TZ=America/New_York
# Encrypts workspace model provider credentials at rest. Defaults to AUTH_SECRET if unset.
