# Cloudflare R2 image storage. Keep endpoint account-scoped and set the bucket separately.
ACC_ID_CLOUDFLARE=
CLOUDFLARE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=social-agent
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Required for social platforms unless the bucket endpoint is public.
R2_PUBLIC_BASE_URL=
# Also accepted when exported by an S3-compatible R2 tool.
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION_NAME=auto
S3_CUSTOM_DOMAIN=

# Optional
SLACK_WEBHOOK_URL=
SENTRY_DSN=
