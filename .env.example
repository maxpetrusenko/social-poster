# Local filesystem article corpus for /dashboard/articles Knowledge FS.
# Defaults to ./data/article-workspace when unset; data/ is gitignored and should be a persistent volume in production.
ARTICLE_WORKSPACE_DIR=./data/article-workspace
# Optional wiki root shown under Articles -> Knowledge FS -> GBrain / Wiki.
GBRAIN_WIKI_DIR="/Users/maxpetrusenko/Google Drive/Obsidian/LLM Wiki"
