TWITTER_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
TOKEN_REFRESH_SWEEP_HOURS=6
TOKEN_REFRESH_WINDOW_DAYS=7
TOKEN_UNKNOWN_EXPIRY_REFRESH_DAYS=30
BIRD_RUNNER=bird
BIRD_SESSION_CHECK_HOURS=24

# Media pipeline
SIMLI_API_KEY=
SIMLI_FACE_ID=e5b26d08-3287-4e0c-a9c5-d5914a7c0de8
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=7270ea4d-a17a-4f21-a3da-03f2b128669d
