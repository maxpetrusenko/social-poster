# Database
DATABASE_URL=./data/social-poster.db

# Auth
AUTH_SECRET=generate-a-random-32-char-string
AUTH_EMAIL=max.petrusenko@gmail.com
DISABLE_AUTH=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Required in production. Optional in local only if you intentionally use magic-link auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
WORKSPACE_ALLOWED_EMAILS=max.petrusenko@gmail.com
WORKSPACE_ALLOWED_DOMAINS=

# App
APP_URL=http://localhost:3000
TZ=America/New_York
OPENAI_API_KEY=
OPENAI_REPLY_MODEL=gpt-5-mini
REPLY_PRODUCT_NAME=Agent Persona
REPLY_PRODUCT_DESCRIPTOR=agent persona framework
REPLY_PRODUCT_URL=agent-persona.org
REPLY_GITHUB_REPO=github.com/agent-persona/personas-pipeline

# Social posting providers
ZERNIO_API_KEY=
ZERNIO_TWITTER_ACCOUNT_ID=
ZERNIO_LINKEDIN_ACCOUNT_ID=
ZERNIO_INSTAGRAM_ACCOUNT_ID=
ZERNIO_TIKTOK_ACCOUNT_ID=
ZERNIO_FACEBOOK_ACCOUNT_ID=

# Native social provider OAuth credentials
