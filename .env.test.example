# X Liked-Post Autopost Configuration
# Copy to .env and adjust values for your environment

# Long posts are ENABLED BY DEFAULT for sources 1500+ chars
# Set to "false" to force short mode (1200 char limit)
# X_LIKES_AUTOPUBLISH_ALLOW_LONG_POSTS=false

# Long post character limit (default: 2500, max: 4000)
X_LIKES_AUTOPUBLISH_LONG_POST_LIMIT=2500
